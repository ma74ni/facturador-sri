<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resumen de incidencias</title>
  <style>
    body { font-family: Arial, sans-serif; line-height: 1.5; color: #333; background-color: #f4f4f4; margin: 0; padding: 0; }
    .container { max-width: 640px; margin: 20px auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; }
    .header { background-color: #004790; color: white; padding: 24px; }
    .header h1 { margin: 0; font-size: 20px; }
    .content { padding: 24px; }
    .stats td { padding: 8px 16px 8px 0; }
    .stats strong { font-size: 20px; }
    h2 { font-size: 16px; margin: 24px 0 8px; }
    table.list { width: 100%; border-collapse: collapse; font-size: 13px; }
    table.list td { padding: 8px; border-bottom: 1px solid #eee; vertical-align: top; }
    .prod { color: #b3261e; font-weight: bold; }
    .button { display: inline-block; padding: 12px 28px; background-color: #004790; color: white !important; text-decoration: none; border-radius: 20px; font-weight: bold; }
    .footer { background-color: #f8f9fa; padding: 16px; text-align: center; font-size: 12px; color: #666; }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>Resumen de incidencias de las últimas 24 h</h1>
    </div>
    <div class="content">
      <table class="stats">
        <tr>
          <td><strong>{{unresolved}}</strong><br>errores sin resolver</td>
          <td><strong>{{stuck}}</strong><br>sin respuesta del SRI</td>
          <td><strong>{{resolved}}</strong><br>resueltos</td>
          <td><strong>{{warnings}}</strong><br>advertencias</td>
        </tr>
      </table>

      {{#if lines.length}}
      <h2>Errores sin resolver</h2>
      <table class="list">
        {{#each lines}}
        <tr>
          <td>{{#if production}}<span class="prod">PRODUCCIÓN</span><br>{{/if}}{{company}}</td>
          <td>{{document}}</td>
          <td>{{message}}</td>
        </tr>
        {{/each}}
      </table>
      {{/if}}

      {{#if stuckLines.length}}
      <h2>Enviados al SRI y sin respuesta (más de 30 min)</h2>
      <table class="list">
        {{#each stuckLines}}
        <tr>
          <td>{{#if production}}<span class="prod">PRODUCCIÓN</span><br>{{/if}}{{company}}</td>
          <td>{{document}}</td>
        </tr>
        {{/each}}
      </table>
      {{/if}}

      {{#if planLines.length}}
      <h2>Empresas cerca del límite de su plan</h2>
      <table class="list">
        {{#each planLines}}
        <tr>
          <td>{{company}}</td>
          <td>{{plan}}</td>
          <td>{{used}} de {{allowed}} comprobantes · {{state}}</td>
        </tr>
        {{/each}}
      </table>
      {{/if}}

      <p style="text-align: center; margin-top: 24px;">
        <a href="{{incidentsLink}}" class="button">Ver incidencias</a>
      </p>
    </div>
    <div class="footer">
      <p>Lo recibes por ser administrador de la plataforma. Solo llega cuando hay algo pendiente.</p>
      <p>© {{year}} Sistema de Facturación Electrónica</p>
    </div>
  </div>
</body>
</html>
