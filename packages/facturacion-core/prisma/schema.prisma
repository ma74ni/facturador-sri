generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  MANAGER
  USER
  VIEWER

}

enum SRIEnvironment {
  TEST
  PRODUCTION

}

enum SRIStatus {
  DRAFT      // Factura creada pero aún no firmada/lista para enviar
  PENDING    // Lista para enviar al SRI
  SENT       // Enviada al SRI, esperando autorización
  AUTHORIZED // Autorizada por el SRI
  REJECTED   // Rechazada por el SRI
  ERROR      // Error en el proceso
  CANCELLED  // Cancelada antes de enviar al SRI

}

enum CompanyStatus {
  PENDING
  APPROVED
  REJECTED

}

enum InvoicePaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

// Acciones del panel de administración de la plataforma (auditoría).
enum PlatformAuditAction {
  COMPANY_APPROVED
  COMPANY_REJECTED
  COMPANY_WENT_LIVE
  EMISSION_SEQUENCE_CHANGED
  PLATFORM_ADMIN_GRANTED
  PLATFORM_ADMIN_REVOKED
  COMPANY_MODULES_CHANGED
}

// ==================== USERS ====================

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  firstName String
  lastName  String
  isActive  Boolean @default(true)
  role      Role    @default(USER)

  // Administra la plataforma (aprueba empresas, las pasa a producción).
  // Independiente de `role`, que es el rol dentro de su propia empresa.
  isPlatformAdmin Boolean @default(false)

  // Email verification
  emailVerified     Boolean   @default(false)
  verificationToken String?   @unique
  verificationTokenExpiry DateTime?
  lastVerificationEmailSent DateTime?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices    Invoice[]    @relation("CreatedBy")
  creditNotes CreditNote[] @relation("CreditNotesCreatedBy")
  payments    Payment[]    @relation("PaymentsCreatedBy")

  platformAuditActions PlatformAuditLog[] @relation("PlatformAuditActor")
  platformAuditTargets PlatformAuditLog[] @relation("PlatformAuditTarget")

  @@index([email])
  @@index([companyId])
  @@index([verificationToken])
  @@map("users")
}

// ==================== COMPANY ====================

model Company {
  id           String  @id @default(cuid())
  ruc          String  @unique
  businessName String
  tradeName    String?
  address      String
  phone        String?
  email        String
  replyToEmail String? // Email para Reply-To

  logoPath String?

  environment SRIEnvironment @default(TEST)
  // Cuándo un administrador de la plataforma la pasó a PRODUCCIÓN.
  productionSince DateTime?
  isActive    Boolean        @default(true)

  // Company approval status
  status CompanyStatus @default(PENDING)
  approvedAt DateTime?
  rejectedAt DateTime?
  rejectionReason String?

  // Configuración de email (Mailjet o custom)
  emailProvider String @default("SYSTEM") // SYSTEM, MAILJET, SMTP

  // Para empresas con su propia cuenta Mailjet
  mailjetApiKey         String?
  mailjetSecretKey      String?
  mailjetFromEmail      String?
  mailjetFromName       String?
  mailjetSenderVerified Boolean @default(false)

  // Para empresas con SMTP propio (futuro)
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?

  // Certificado Digital
  certificatePath     String?
  certificatePassword String?
  certificateExpiry   DateTime?
  hasCertificate      Boolean   @default(false)

  // Módulos de producto habilitados para este tenant (ej. "cobranza") — ver RequireModuleGuard
  enabledModules String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  establishments Establishment[]
  customers      Customer[]
  products       Product[]
  invoices       Invoice[]
  creditNotes    CreditNote[]
  payments       Payment[]

  platformAuditLogs PlatformAuditLog[]

  @@index([ruc])
  @@map("companies")
}

// Registro de lo que hace cada administrador de la plataforma. Guarda el
// email del actor y el RUC como copia: el registro sobrevive aunque se borre
// el usuario o la empresa.
model PlatformAuditLog {
  id     String              @id @default(cuid())
  action PlatformAuditAction

  actorId    String?
  actor      User?   @relation("PlatformAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorEmail String

  companyId  String?
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyRuc String?

  targetUserId String?
  targetUser   User?   @relation("PlatformAuditTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  details Json?

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
  @@map("platform_audit_logs")
}

// ==================== ESTABLISHMENTS ====================

model Establishment {
  id      String  @id @default(cuid())
  code    String
  name    String
  address String
  phone   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  emissionPoints EmissionPoint[]
  invoices       Invoice[]
  creditNotes    CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("establishments")
}

model EmissionPoint {
  id          String  @id @default(cuid())
  code        String
  description String?

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  invoiceSequence    Int @default(1)
  creditNoteSequence Int @default(1)

  invoices    Invoice[]
  creditNotes CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([establishmentId, code])
  @@index([establishmentId])
  @@map("emission_points")
}

// ==================== CUSTOMERS ====================

model Customer {
  id                 String  @id @default(cuid())
  identificationType String
  identification     String
  businessName       String?
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  address            String?
  // % de retención en la fuente que este cliente aplica habitualmente (ver
  // PaymentAllocation.retentionAmount) — null/0 = no retiene. Precalcula la
  // retención al registrar un pago, no hace falta que el usuario la calcule.
  retentionPercentage Decimal? @db.Decimal(5, 2)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoices    Invoice[]
  creditNotes CreditNote[]
  payments    Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, identification])
  @@index([companyId])
  @@index([identification])
  @@map("customers")
}

// ==================== PRODUCTS ====================

model Product {
  id          String  @id @default(cuid())
  mainCode    String
  name        String
  description String?
  unitPrice   Decimal @db.Decimal(12, 6)

  taxCode           String
  taxPercentageCode String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceItems    InvoiceItem[]
  creditNoteItems CreditNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, mainCode])
  @@index([companyId])
  @@map("products")
}

// ==================== EMAIL LOGS ====================

model EmailLog {
  id        String    @id @default(cuid())
  invoiceId String
  recipient String
  subject   String
  status    String // SENT, FAILED, PENDING
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@map("email_logs")
}

// ==================== INVOICES ====================

model Invoice {
  id String @id @default(cuid())

  documentType      String
  accessKey         String @unique
  establishmentCode String
  emissionPointCode String
  sequential        String

  issueDate DateTime

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  emissionPointId String
  emissionPoint   EmissionPoint @relation(fields: [emissionPointId], references: [id])

  subtotal      Decimal @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @db.Decimal(12, 2)
  ivaValue      Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  sriStatus           SRIStatus @default(DRAFT)
  authorizationNumber String?
  authorizationDate   DateTime?
  sriErrors           Json?

  // Rutas de archivos
  xmlPath       String?
  xmlSignedPath String?
  ridePdfPath   String?

  // Auditoría y control
  cancelledAt DateTime?
  cancelReason String?

  // Metadata para integraciones (POS, etc)
  metadata Json?

  // Cobranza: estado de cobro, independiente del estado SRI. Se recalcula
  // transaccionalmente desde PaymentAllocation (ver PaymentsService)
  paymentStatus InvoicePaymentStatus @default(PENDING)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       InvoiceItem[]
  emailLogs   EmailLog[]
  creditNotes CreditNote[] @relation("InvoiceCreditNotes")
  allocations PaymentAllocation[]

  @@index([accessKey])
  @@index([sriStatus])
  @@index([companyId, issueDate])
  @@index([customerId])
  @@index([paymentStatus])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  mainCode    String
  description String
  quantity    Decimal @db.Decimal(12, 6)
  unitPrice   Decimal @db.Decimal(12, 6)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  // Base imponible de la línea (precioTotalSinImpuesto del SRI).
  subtotal    Decimal @db.Decimal(12, 2)

  // IVA de la línea al momento de la emisión: si el producto cambia de
  // tarifa después, el comprobante no cambia. Tabla 17 del SRI.
  ivaCode  String
  ivaRate  Decimal @db.Decimal(5, 2)
  ivaValue Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}

// ==================== PAYMENTS (cobranza) ====================
// Cuenta corriente por cliente: un Payment puede saldar total o parcialmente
// una o varias Invoice (ver PaymentAllocation). Módulo gateado por
// Company.enabledModules — ver RequireModuleGuard.

model Payment {
  id          String   @id @default(cuid())
  paymentDate DateTime
  totalAmount Decimal  @db.Decimal(12, 2)
  reference   String? // n° de comprobante/transferencia, opcional
  note        String?

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("PaymentsCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())

  allocations PaymentAllocation[]

  @@index([companyId, customerId])
  @@map("payments")
}

model PaymentAllocation {
  id     String  @id @default(cuid())
  amount Decimal @db.Decimal(12, 2)
  // Retención en la fuente aplicada a esta factura dentro de este pago (opcional,
  // varía por transacción/comprador — no toda la plata "no recibida" es deuda).
  // Cuenta para saldar la factura (amount + retentionAmount) pero no para
  // Payment.totalAmount, que sigue siendo solo el efectivo real.
  retentionAmount Decimal @default(0) @db.Decimal(12, 2)

  paymentId String
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id])

  createdAt DateTime @default(now())

  @@unique([paymentId, invoiceId])
  @@index([invoiceId])
  @@map("payment_allocations")
}

// ==================== CREDIT NOTES ====================

model CreditNote {
  id String @id @default(cuid())

  documentType      String // "04"
  accessKey         String @unique
  establishmentCode String
  emissionPointCode String
  sequential        String

  issueDate DateTime

  // Referencia a la factura modificada
  modifiedInvoiceId String
  modifiedInvoice   Invoice  @relation("InvoiceCreditNotes", fields: [modifiedInvoiceId], references: [id])
  modifiedDocType   String // "01" = Factura
  modifiedNumber    String // Número completo: 001-001-000000001

  // Motivo de la nota de crédito
  reason String // Anulación, Devolución, Descuento, etc.

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  emissionPointId String
  emissionPoint   EmissionPoint @relation(fields: [emissionPointId], references: [id])

  subtotal      Decimal @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @db.Decimal(12, 2)
  ivaValue      Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  sriStatus           SRIStatus @default(DRAFT)
  authorizationNumber String?
  authorizationDate   DateTime?
  sriErrors           Json?

  // Rutas de archivos
  xmlPath       String?
  xmlSignedPath String?
  ridePdfPath   String?

  // Auditoría y control
  cancelledAt DateTime?
  cancelReason String?

  // Metadata para integraciones (POS, etc)
  metadata Json?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreditNotesCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     CreditNoteItem[]
  emailLogs CreditNoteEmailLog[]

  @@index([accessKey])
  @@index([sriStatus])
  @@index([companyId, issueDate])
  @@index([customerId])
  @@index([modifiedInvoiceId])
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  mainCode    String
  description String
  quantity    Decimal @db.Decimal(12, 6)
  unitPrice   Decimal @db.Decimal(12, 6)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  // Base imponible de la línea (precioTotalSinImpuesto del SRI).
  subtotal    Decimal @db.Decimal(12, 2)

  // IVA de la línea al momento de la emisión. Tabla 17 del SRI.
  ivaCode  String
  ivaRate  Decimal @db.Decimal(5, 2)
  ivaValue Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([creditNoteId])
  @@map("credit_note_items")
}

model CreditNoteEmailLog {
  id           String     @id @default(cuid())
  creditNoteId String
  recipient    String
  subject      String
  status       String // SENT, FAILED, PENDING
  sentAt       DateTime?
  error        String?
  createdAt    DateTime   @default(now())

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
  @@index([status])
  @@map("credit_note_email_logs")
}
