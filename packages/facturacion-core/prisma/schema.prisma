generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["facturacion_core"]
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  MANAGER
  USER
  VIEWER

  @@schema("facturacion_core")
}

enum SRIEnvironment {
  TEST
  PRODUCTION

  @@schema("facturacion_core")
}

enum SRIStatus {
  PENDING
  SENT
  AUTHORIZED
  REJECTED
  ERROR

  @@schema("facturacion_core")
}

// ==================== USERS ====================

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  firstName String
  lastName  String
  isActive  Boolean @default(true)
  role      Role    @default(USER)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices    Invoice[]    @relation("CreatedBy")
  creditNotes CreditNote[] @relation("CreditNotesCreatedBy")

  @@index([email])
  @@index([companyId])
  @@schema("facturacion_core")
  @@map("users")
}

// ==================== COMPANY ====================

model Company {
  id           String  @id @default(cuid())
  ruc          String  @unique
  businessName String
  tradeName    String?
  address      String
  phone        String?
  email        String
  replyToEmail String? // Email para Reply-To

  logoPath String?

  environment SRIEnvironment @default(TEST)
  isActive    Boolean        @default(true)

  // Configuración de email (Mailjet o custom)
  emailProvider String @default("SYSTEM") // SYSTEM, MAILJET, SMTP

  // Para empresas con su propia cuenta Mailjet
  mailjetApiKey         String?
  mailjetSecretKey      String?
  mailjetFromEmail      String?
  mailjetFromName       String?
  mailjetSenderVerified Boolean @default(false)

  // Para empresas con SMTP propio (futuro)
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?

  // Certificado Digital
  certificatePath     String?
  certificatePassword String?
  certificateExpiry   DateTime?
  hasCertificate      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  establishments Establishment[]
  customers      Customer[]
  products       Product[]
  invoices       Invoice[]
  creditNotes    CreditNote[]

  @@index([ruc])
  @@schema("facturacion_core")
  @@map("companies")
}

// ==================== ESTABLISHMENTS ====================

model Establishment {
  id      String  @id @default(cuid())
  code    String
  name    String
  address String
  phone   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  emissionPoints EmissionPoint[]
  invoices       Invoice[]
  creditNotes    CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@schema("facturacion_core")
  @@map("establishments")
}

model EmissionPoint {
  id          String  @id @default(cuid())
  code        String
  description String?

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  invoiceSequence    Int @default(1)
  creditNoteSequence Int @default(1)

  invoices    Invoice[]
  creditNotes CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([establishmentId, code])
  @@index([establishmentId])
  @@schema("facturacion_core")
  @@map("emission_points")
}

// ==================== CUSTOMERS ====================

model Customer {
  id                 String  @id @default(cuid())
  identificationType String
  identification     String
  businessName       String?
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  address            String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoices    Invoice[]
  creditNotes CreditNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, identification])
  @@index([companyId])
  @@index([identification])
  @@schema("facturacion_core")
  @@map("customers")
}

// ==================== PRODUCTS ====================

model Product {
  id          String  @id @default(cuid())
  mainCode    String
  name        String
  description String?
  unitPrice   Decimal @db.Decimal(12, 6)

  taxCode           String
  taxPercentageCode String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceItems    InvoiceItem[]
  creditNoteItems CreditNoteItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, mainCode])
  @@index([companyId])
  @@schema("facturacion_core")
  @@map("products")
}

// ==================== EMAIL LOGS ====================

model EmailLog {
  id        String    @id @default(cuid())
  invoiceId String
  recipient String
  subject   String
  status    String // SENT, FAILED, PENDING
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@schema("facturacion_core")
  @@map("email_logs")
}

// ==================== INVOICES ====================

model Invoice {
  id String @id @default(cuid())

  documentType      String
  accessKey         String @unique
  establishmentCode String
  emissionPointCode String
  sequential        String

  issueDate DateTime

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  emissionPointId String
  emissionPoint   EmissionPoint @relation(fields: [emissionPointId], references: [id])

  subtotal      Decimal @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @db.Decimal(12, 2)
  ivaValue      Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  sriStatus           SRIStatus @default(PENDING)
  authorizationNumber String?
  authorizationDate   DateTime?
  sriErrors           Json?

  // Rutas de archivos
  xmlPath       String?
  xmlSignedPath String?
  ridePdfPath   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items       InvoiceItem[]
  emailLogs   EmailLog[]
  creditNotes CreditNote[] @relation("InvoiceCreditNotes")

  @@index([accessKey])
  @@index([sriStatus])
  @@index([companyId, issueDate])
  @@index([customerId])
  @@schema("facturacion_core")
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  mainCode    String
  description String
  quantity    Decimal @db.Decimal(12, 6)
  unitPrice   Decimal @db.Decimal(12, 6)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@schema("facturacion_core")
  @@map("invoice_items")
}

// ==================== CREDIT NOTES ====================

model CreditNote {
  id String @id @default(cuid())

  documentType      String // "04"
  accessKey         String @unique
  establishmentCode String
  emissionPointCode String
  sequential        String

  issueDate DateTime

  // Referencia a la factura modificada
  modifiedInvoiceId String
  modifiedInvoice   Invoice  @relation("InvoiceCreditNotes", fields: [modifiedInvoiceId], references: [id])
  modifiedDocType   String // "01" = Factura
  modifiedNumber    String // Número completo: 001-001-000000001

  // Motivo de la nota de crédito
  reason String // Anulación, Devolución, Descuento, etc.

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  emissionPointId String
  emissionPoint   EmissionPoint @relation(fields: [emissionPointId], references: [id])

  subtotal      Decimal @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @db.Decimal(12, 2)
  ivaValue      Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  sriStatus           SRIStatus @default(PENDING)
  authorizationNumber String?
  authorizationDate   DateTime?
  sriErrors           Json?

  // Rutas de archivos
  xmlPath       String?
  xmlSignedPath String?
  ridePdfPath   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreditNotesCreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     CreditNoteItem[]
  emailLogs CreditNoteEmailLog[]

  @@index([accessKey])
  @@index([sriStatus])
  @@index([companyId, issueDate])
  @@index([customerId])
  @@index([modifiedInvoiceId])
  @@schema("facturacion_core")
  @@map("credit_notes")
}

model CreditNoteItem {
  id           String     @id @default(cuid())
  creditNoteId String
  creditNote   CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  mainCode    String
  description String
  quantity    Decimal @db.Decimal(12, 6)
  unitPrice   Decimal @db.Decimal(12, 6)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([creditNoteId])
  @@schema("facturacion_core")
  @@map("credit_note_items")
}

model CreditNoteEmailLog {
  id           String     @id @default(cuid())
  creditNoteId String
  recipient    String
  subject      String
  status       String // SENT, FAILED, PENDING
  sentAt       DateTime?
  error        String?
  createdAt    DateTime   @default(now())

  creditNote CreditNote @relation(fields: [creditNoteId], references: [id], onDelete: Cascade)

  @@index([creditNoteId])
  @@index([status])
  @@schema("facturacion_core")
  @@map("credit_note_email_logs")
}
