# APPLICATION

NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# DATABASE

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facturador_db?schema=public"

# JWT

JWT_SECRET=tu-secret-super-seguro-cambiar-en-produccion
JWT_EXPIRATION=7d

# CORS

# Obligatorio con NODE_ENV=production; vacío en desarrollo acepta cualquier origen.
CORS_ORIGIN=http://localhost:3001

# Swagger (/api/docs) está apagado con NODE_ENV=production salvo que se active aquí.
# SWAGGER_ENABLED=true
