generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  MANAGER
  USER
  VIEWER
}

enum SRIEnvironment {
  TEST
  PRODUCTION
}

enum SRIStatus {
  PENDING
  SENT
  AUTHORIZED
  REJECTED
  ERROR
}

// ==================== USERS ====================

model User {
  id        String  @id @default(cuid())
  email     String  @unique
  password  String
  firstName String
  lastName  String
  isActive  Boolean @default(true)
  role      Role    @default(USER)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[] @relation("CreatedBy")

  @@index([email])
  @@index([companyId])
  @@map("users")
}

// ==================== COMPANY ====================

model Company {
  id           String  @id @default(cuid())
  ruc          String  @unique
  businessName String
  tradeName    String?
  address      String
  phone        String?
  email        String
  replyToEmail String? // Email para Reply-To

  logoPath String?

  environment SRIEnvironment @default(TEST)
  isActive    Boolean        @default(true)

  // Configuración de email (Mailjet o custom)
  emailProvider String @default("SYSTEM") // SYSTEM, MAILJET, SMTP

  // Para empresas con su propia cuenta Mailjet
  mailjetApiKey         String?
  mailjetSecretKey      String?
  mailjetFromEmail      String?
  mailjetFromName       String?
  mailjetSenderVerified Boolean @default(false)

  // Para empresas con SMTP propio (futuro)
  smtpHost     String?
  smtpPort     Int?
  smtpUser     String?
  smtpPassword String?

  // Certificado Digital
  certificatePath     String?
  certificatePassword String?
  certificateExpiry   DateTime?
  hasCertificate      Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users          User[]
  establishments Establishment[]
  customers      Customer[]
  products       Product[]
  invoices       Invoice[]

  @@index([ruc])
  @@map("companies")
}

// ==================== ESTABLISHMENTS ====================

model Establishment {
  id      String  @id @default(cuid())
  code    String
  name    String
  address String
  phone   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  emissionPoints EmissionPoint[]
  invoices       Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("establishments")
}

model EmissionPoint {
  id          String  @id @default(cuid())
  code        String
  description String?

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  invoiceSequence Int @default(1)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([establishmentId, code])
  @@index([establishmentId])
  @@map("emission_points")
}

// ==================== CUSTOMERS ====================

model Customer {
  id                 String  @id @default(cuid())
  identificationType String
  identification     String
  businessName       String?
  firstName          String?
  lastName           String?
  email              String?
  phone              String?
  address            String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, identification])
  @@index([companyId])
  @@index([identification])
  @@map("customers")
}

// ==================== PRODUCTS ====================

model Product {
  id          String  @id @default(cuid())
  mainCode    String
  name        String
  description String?
  unitPrice   Decimal @db.Decimal(12, 6)

  taxCode           String
  taxPercentageCode String

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  invoiceItems InvoiceItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, mainCode])
  @@index([companyId])
  @@map("products")
}

// ==================== EMAIL LOGS ====================

model EmailLog {
  id        String    @id @default(cuid())
  invoiceId String
  recipient String
  subject   String
  status    String // SENT, FAILED, PENDING
  sentAt    DateTime?
  error     String?
  createdAt DateTime  @default(now())

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([status])
  @@map("email_logs")
}

// ==================== INVOICES ====================

model Invoice {
  id String @id @default(cuid())

  documentType      String
  accessKey         String @unique
  establishmentCode String
  emissionPointCode String
  sequential        String

  issueDate DateTime

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])

  establishmentId String
  establishment   Establishment @relation(fields: [establishmentId], references: [id])

  emissionPointId String
  emissionPoint   EmissionPoint @relation(fields: [emissionPointId], references: [id])

  subtotal      Decimal @db.Decimal(12, 2)
  totalDiscount Decimal @default(0) @db.Decimal(12, 2)
  ivaValue      Decimal @db.Decimal(12, 2)
  total         Decimal @db.Decimal(12, 2)

  sriStatus           SRIStatus @default(PENDING)
  authorizationNumber String?
  authorizationDate   DateTime?
  sriErrors           Json?

  // Rutas de archivos
  xmlPath       String?
  xmlSignedPath String?
  ridePdfPath   String?

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdById String
  createdBy   User   @relation("CreatedBy", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items     InvoiceItem[]
  emailLogs EmailLog[]

  @@index([accessKey])
  @@index([sriStatus])
  @@index([companyId, issueDate])
  @@index([customerId])
  @@map("invoices")
}

model InvoiceItem {
  id        String  @id @default(cuid())
  invoiceId String
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  mainCode    String
  description String
  quantity    Decimal @db.Decimal(12, 6)
  unitPrice   Decimal @db.Decimal(12, 6)
  discount    Decimal @default(0) @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@map("invoice_items")
}
