{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm lint:all)",
      "Bash(pnpm test:all)",
      "Bash(pnpm build:all)",
      "Bash(pnpm format:check *)",
      "Bash(pnpm --filter facturacion-core lint)",
      "Bash(pnpm --filter facturacion-core test)",
      "Bash(pnpm --filter facturacion-core test *)",
      "Bash(pnpm --filter facturacion-core build)",
      "Bash(pnpm --filter facturacion-core prisma:generate)",
      "Bash(pnpm --filter web-facturacion lint)",
      "Bash(pnpm --filter web-facturacion type-check)",
      "Bash(pnpm --filter web-facturacion build)",
      "Bash(pnpm audit *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(git fetch *)",
      "mcp__context7"
    ],
    "deny": [
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)",
      "Edit(./**/.env)",
      "Edit(./**/.env.local)",
      "Bash(*prisma migrate reset*)",
      "Bash(*prisma db push*)",
      "Bash(git push --force *)",
      "Bash(git push -f *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-edited-file.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
